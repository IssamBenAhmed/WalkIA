<mujoco model="mon_robot">
    <compiler angle="degree" inertiafromgeom="true"/>
    <option timestep="0.01" gravity="0 0 -9.81"/>
    
    <default>
        <geom conaffinity="1" condim="3" friction="1 0.5 0.5" margin="0.001" rgba="0.8 0.6 0.4 1"/>
        <joint armature="0.01" damping="0.1" limited="true"/>
        <motor ctrllimited="true" ctrlrange="-1.0 1.0"/>
    </default>

    <asset>
        <texture builtin="checker" height="100" name="texplane" rgb1="0.1 0.2 0.3" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
        <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="20 20" texture="texplane"/>
    </asset>

    <worldbody>
        <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
        <geom conaffinity="1" condim="3" material="MatPlane" name="floor" pos="0 0 0" size="10 10 0.1" type="plane"/>
        
        <body name="torso" pos="0 0 1.2">
            <camera name="track" mode="trackcom" pos="0 -3 1" xyaxes="1 0 0 0 0 1"/>
            
            <joint armature="0" axis="1 0 0" damping="0" limited="false" name="rootx" pos="0 0 0" stiffness="0" type="slide"/>
            <joint armature="0" axis="0 0 1" damping="0" limited="false" name="rootz" pos="0 0 0" stiffness="0" type="slide"/>
            <joint armature="0" axis="0 1 0" damping="0" limited="false" name="rooty" pos="0 0 0" stiffness="0" type="hinge"/>
            
            <geom name="torso_geom" pos="0 0 0" size="0.22 0.14 0.22" type="box" rgba="0.8 0.2 0.2 1"/>

            <!-- Jambe avant gauche -->
            <body name="jambe_avant_gauche" pos="0.18 0.15 -0.22">
                <joint axis="0 1 0" name="articulation_hanche_avant_gauche" pos="0 0 0" range="-45 45" type="hinge"/>
                <geom fromto="0 0 0 0 0 -0.4" name="cuisse_avant_gauche_geom" size="0.05" type="capsule" rgba="0.2 0.8 0.2 1"/>
                <body name="mollet_avant_gauche" pos="0 0 -0.4">
                    <joint axis="0 1 0" name="articulation_genou_avant_gauche" pos="0 0 0" range="-45 45" type="hinge"/>
                    <geom fromto="0 0 0 0 0 -0.4" name="mollet_avant_gauche_geom" size="0.04" type="capsule" rgba="0.2 0.2 0.8 1"/>
                    
                    <!-- PALME DE CANARD AVANT GAUCHE -->
                    <body name="pied_avant_gauche" pos="0 0 -0.4">
                        <joint axis="0 1 0" name="articulation_cheville_avant_gauche" pos="0 0 0" range="-30 45" type="hinge"/>
                        <geom pos="0.06 0 0" size="0.12 0.08 0.02" type="box" rgba="0.9 0.5 0.1 1" name="palme_avant_gauche_geom"/>
                    </body>
                </body>
            </body>

            <!-- Jambe avant droite -->
            <body name="jambe_avant_droite" pos="0.18 -0.15 -0.22">
                <joint axis="0 1 0" name="articulation_hanche_avant_droite" pos="0 0 0" range="-45 45" type="hinge"/>
                <geom fromto="0 0 0 0 0 -0.4" name="cuisse_avant_droite_geom" size="0.05" type="capsule" rgba="0.2 0.8 0.2 1"/>
                <body name="mollet_avant_droite" pos="0 0 -0.4">
                    <joint axis="0 1 0" name="articulation_genou_avant_droite" pos="0 0 0" range="-45 45" type="hinge"/>
                    <geom fromto="0 0 0 0 0 -0.4" name="mollet_avant_droite_geom" size="0.04" type="capsule" rgba="0.2 0.2 0.8 1"/>
                    
                    <!-- PALME DE CANARD AVANT DROITE -->
                    <body name="pied_avant_droite" pos="0 0 -0.4">
                        <joint axis="0 1 0" name="articulation_cheville_avant_droite" pos="0 0 0" range="-30 45" type="hinge"/>
                        <geom pos="0.06 0 0" size="0.12 0.08 0.02" type="box" rgba="0.9 0.5 0.1 1" name="palme_avant_droite_geom"/>
                    </body>
                </body>
            </body>

            <!-- Jambe arrière gauche -->
            <body name="jambe_arriere_gauche" pos="-0.18 0.15 -0.22">
                <joint axis="0 1 0" name="articulation_hanche_arriere_gauche" pos="0 0 0" range="-45 45" type="hinge"/>
                <geom fromto="0 0 0 0 0 -0.4" name="cuisse_arriere_gauche_geom" size="0.05" type="capsule" rgba="0.2 0.8 0.2 1"/>
                <body name="mollet_arriere_gauche" pos="0 0 -0.4">
                    <joint axis="0 1 0" name="articulation_genou_arriere_gauche" pos="0 0 0" range="-45 45" type="hinge"/>
                    <geom fromto="0 0 0 0 0 -0.4" name="mollet_arriere_gauche_geom" size="0.04" type="capsule" rgba="0.2 0.2 0.8 1"/>
                    
                    <!-- PALME DE CANARD ARRIÈRE GAUCHE -->
                    <body name="pied_arriere_gauche" pos="0 0 -0.4">
                        <joint axis="0 1 0" name="articulation_cheville_arriere_gauche" pos="0 0 0" range="-30 45" type="hinge"/>
                        <geom pos="0.06 0 0" size="0.12 0.08 0.02" type="box" rgba="0.9 0.5 0.1 1" name="palme_arriere_gauche_geom"/>
                    </body>
                </body>
            </body>

            <!-- Jambe arrière droite -->
            <body name="jambe_arriere_droite" pos="-0.18 -0.15 -0.22">
                <joint axis="0 1 0" name="articulation_hanche_arriere_droite" pos="0 0 0" range="-45 45" type="hinge"/>
                <geom fromto="0 0 0 0 0 -0.4" name="cuisse_arriere_droite_geom" size="0.05" type="capsule" rgba="0.2 0.8 0.2 1"/>
                <body name="mollet_arriere_droite" pos="0 0 -0.4">
                    <joint axis="0 1 0" name="articulation_genou_arriere_droite" pos="0 0 0" range="-45 45" type="hinge"/>
                    <geom fromto="0 0 0 0 0 -0.4" name="mollet_arriere_droite_geom" size="0.04" type="capsule" rgba="0.2 0.2 0.8 1"/>
                    
                    <!-- PALME DE CANARD ARRIÈRE DROITE -->
                    <body name="pied_arriere_droite" pos="0 0 -0.4">
                        <joint axis="0 1 0" name="articulation_cheville_arriere_droite" pos="0 0 0" range="-30 45" type="hinge"/>
                        <geom pos="0.06 0 0" size="0.12 0.08 0.02" type="box" rgba="0.9 0.5 0.1 1" name="palme_arriere_droite_geom"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Hanches -->
        <motor gear="50" joint="articulation_hanche_avant_gauche" name="moteur_hanche_avant_gauche"/>
        <motor gear="50" joint="articulation_hanche_avant_droite" name="moteur_hanche_avant_droite"/>
        <motor gear="50" joint="articulation_hanche_arriere_gauche" name="moteur_hanche_arriere_gauche"/>
        <motor gear="50" joint="articulation_hanche_arriere_droite" name="moteur_hanche_arriere_droite"/>
        
        <!-- Genoux -->
        <motor gear="50" joint="articulation_genou_avant_gauche" name="moteur_genou_avant_gauche"/>
        <motor gear="50" joint="articulation_genou_avant_droite" name="moteur_genou_avant_droite"/>
        <motor gear="50" joint="articulation_genou_arriere_gauche" name="moteur_genou_arriere_gauche"/>
        <motor gear="50" joint="articulation_genou_arriere_droite" name="moteur_genou_arriere_droite"/>
        
        <!-- Chevilles (Palmes) -->
        <motor gear="30" joint="articulation_cheville_avant_gauche" name="moteur_cheville_avant_gauche"/>
        <motor gear="30" joint="articulation_cheville_avant_droite" name="moteur_cheville_avant_droite"/>
        <motor gear="30" joint="articulation_cheville_arriere_gauche" name="moteur_cheville_arriere_gauche"/>
        <motor gear="30" joint="articulation_cheville_arriere_droite" name="moteur_cheville_arriere_droite"/>
    </actuator>
</mujoco>
